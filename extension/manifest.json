{
  "manifest_version": 3,
  "name": "Recipe Distiller",
  "version": "1.0.0",
  "description": "One click on a recipe page opens Recipe Distiller with that URL — just the recipe, no ads.",
  "action": {
    "default_title": "Distill this recipe"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
